---
import AstroSeo from '@/components/AstroSeo.astro';
import GlobalStructuredData from '@/components/GlobalStructuredData.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import AdSense from '@/components/AdSense.astro';
import { getMeta } from '@/lib/meta';
import type { PageMeta } from '@/lib/meta';
import '@/styles/global.css';

interface Props {
  meta: PageMeta;
  title?: string;
  /** Use wider main (max-w-7xl) for two-column pages like N-letter-words */
  wide?: boolean;
  /** Game layout - centered content with no sidebar constraints */
  game?: boolean;
  /** Full-width main (no container); page supplies its own layout e.g. hero bleed */
  fullBleed?: boolean;
}
const { meta, wide = false, game = false, fullBleed = false } = Astro.props;
const mainClass = fullBleed
  ? 'page-main w-full max-w-none px-0 py-0 mx-0'
  : game 
    ? 'page-main container mx-auto px-4 py-6 max-w-lg' 
    : wide 
      ? 'page-main container mx-auto px-4 py-8 max-w-7xl' 
      : 'page-main container mx-auto px-4 py-8 max-w-4xl';
---
<!doctype html>
<html lang="en">
  <head>
    <AstroSeo
      title={meta.title}
      description={meta.description}
      canonical={meta.canonical}
      noindex={meta.noindex}
      ogType={meta.ogType}
      ogImage={meta.ogImage}
      twitterCard={meta.twitterCard}
      twitterSite={meta.twitterSite}
      noTitleSuffix={meta.noTitleSuffix}
    />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FKV97BJX9X"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FKV97BJX9X');
    </script>
    <!-- Google AdSense site verification -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4029852999519192" crossorigin="anonymous"></script>
    <script is:inline>
      (function(){var k='word-unscrambler-theme';var s=typeof localStorage!=='undefined'?localStorage.getItem(k):null;var d=typeof window!=='undefined'&&window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;if(s==='dark'||(!s&&d))document.documentElement.classList.add('dark');})();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <SiteHeader />
    <main id="main-content" class={mainClass} role="main">
      <slot />
    </main>
    <AdSense />
    <SiteFooter />
    <GlobalStructuredData
      title={meta.title}
      description={meta.description}
      canonical={meta.canonical}
      pathname={Astro.url.pathname}
    />
    <slot name="footer" />
    <script>
      // Stagger section entrance animations
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.querySelectorAll('.stagger-item').forEach((el) => el.classList.add('visible'));
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.stagger-section').forEach((s) => observer.observe(s));

      // Tool pages: auto-build left sidebar + right article layout
      const toolWrappers = document.querySelectorAll('.tool-page-skin .tool-content > .page-wrapper');
      toolWrappers.forEach((wrapper) => {
        if (!(wrapper instanceof HTMLElement)) return;
        if (wrapper.querySelector('.tool-main-with-sidebar')) return;

        const shell = document.createElement('div');
        shell.className = 'tool-main-with-sidebar';

        const sidebar = document.createElement('aside');
        sidebar.className = 'tool-main-sidebar';
        sidebar.innerHTML = `
          <section class="tool-side-card" aria-label="Word Finders">
            <h3 class="tool-side-title">Word Finders</h3>
            <ul class="tool-side-links">
              <li><a href="/wordle">Wordle</a></li>
              <li><a href="/anagram-solver">Anagram Solver</a></li>
              <li><a href="/jumble-solver">Jumble Solver</a></li>
              <li><a href="/scrabble-go">Scrabble Go Word Finder</a></li>
              <li><a href="/scrabble">Scrabble Word Finder</a></li>
              <li><a href="/scrabble-cheat">Scrabble® and Scrabble® Go Cheat</a></li>
              <li><a href="/unscramble">Unscramble Words</a></li>
              <li><a href="/word-cookies">Word Cookies Cheat</a></li>
              <li><a href="/descrambler">Word Descrambler</a></li>
              <li><a href="/word-finder">Word Finder</a></li>
              <li><a href="/word-generator">Word Generator</a></li>
              <li><a href="/word-scramble">Word Scramble</a></li>
              <li><a href="/word-solver">Word Solver</a></li>
              <li><a href="/word-unscrambler">Word Unscrambler</a></li>
              <li><a href="/wordfeud">Wordfeud Cheat</a></li>
              <li><a href="/wordle-solver">Wordle Solver</a></li>
              <li><a href="/words-with-friends">Words with Friends Help</a></li>
              <li><a href="/wordscapes">Wordscapes Cheats and Answers</a></li>
            </ul>
          </section>
          <section class="tool-side-card" aria-label="List of Words">
            <h3 class="tool-side-title">List of Words</h3>
            <ul class="tool-side-links">
              <li><a href="/words-by-length">words by length</a></li>
              <li><a href="/words-start-with">words start with</a></li>
              <li><a href="/words-with-letters">words with letters</a></li>
            </ul>
          </section>
          <section class="tool-side-card" aria-label="Words by Length">
            <h3 class="tool-side-title">Words by Length</h3>
            <ul class="tool-side-links">
              <li><a href="/ten-letter-words">10-Letter Words</a></li>
              <li><a href="/nine-letter-words">9-Letter Words</a></li>
              <li><a href="/eight-letter-words">8-Letter Words</a></li>
              <li><a href="/seven-letter-words">7-Letter Words</a></li>
              <li><a href="/six-letter-words">6-Letter Words</a></li>
              <li><a href="/five-letter-words">5-Letter Words</a></li>
              <li><a href="/four-letter-words">4-Letter Words</a></li>
              <li><a href="/three-letter-words">3-Letter Words</a></li>
              <li><a href="/two-letter-words">2-Letter Words</a></li>
            </ul>
          </section>
        `;

        const article = document.createElement('div');
        article.className = 'tool-main-article';
        while (wrapper.firstChild) {
          article.appendChild(wrapper.firstChild);
        }

        shell.appendChild(sidebar);
        shell.appendChild(article);
        wrapper.appendChild(shell);
      });
    </script>
  </body>
</html>
